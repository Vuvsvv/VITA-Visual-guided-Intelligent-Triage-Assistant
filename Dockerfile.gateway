FROM python:3.10-slim
WORKDIR /app

RUN pip install --no-cache-dir \
    fastapi==0.109.0 \
    uvicorn[standard]==0.27.0 \
    python-multipart==0.0.6 \
    httpx==0.27.0 \
    pyyaml==6.0.1 \
    pydantic==2.5.0

COPY gateway.py .
COPY security.py .
COPY services_config_docker.yaml services_config.yaml

ENV GATEWAY_CONFIG=services_config.yaml
EXPOSE 8000
CMD ["uvicorn", "gateway:app", "--host", "0.0.0.0", "--port", "8000"]
