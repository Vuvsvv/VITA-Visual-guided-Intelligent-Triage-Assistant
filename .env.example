# ============================================
# AI 模型服務網關 - 環境變數設定
# ============================================

# ── 必填 ──

# Gemini API 密鑰（只有台語 TTS 用得到；台語 ASR 不需要）
GEMINI_API_KEY=your_gemini_api_key_here

# 網關 API Key（後端呼叫網關時需要帶在 X-API-Key header）
# 單一 key（預設具備 admin 權限，可以打 /api/reload-config）:
API_KEY=sk-your-secret-key-here
# 想限縮單一 key 的權限就設這個（預設 '*'）:
# API_KEY_PERMISSIONS=process
#
# 多組 keys（用逗號分隔，格式 key:名稱[:權限]）:
# 沒寫第三段 = 只有 process 權限，打不了 /api/reload-config
# API_KEYS=sk-key1:後端A,sk-key2:後端B,sk-ops:維運:*

# ── 安全設定（選填）──

# 允許的 CORS 來源（用逗號分隔）
ALLOWED_ORIGINS=http://localhost:3000,https://yourdomain.com

# 速率限制：每把 key（以 key 的 hash 分桶）在 RATE_WINDOW 秒內最多 RATE_LIMIT 次請求
RATE_LIMIT=60
RATE_WINDOW=60
# 速率限制器的記憶體回收間隔（秒）
# RATE_LIMIT_CLEANUP_INTERVAL=60

# 前面有幾層「自己信任的」反向代理（Nginx = 1）。
# 設 0（預設）時完全忽略 X-Forwarded-For —— 否則任何人都能偽造來源 IP 繞過速率限制。
# 設 >0 時，未認證請求會依 X-Forwarded-For 的來源分桶，而不是全部擠在 127.0.0.1 一桶。
# TRUSTED_PROXY_HOPS=1
# FORWARDED_ALLOW_IPS=127.0.0.1

# 上傳檔案大小上限（MB）；要和 Nginx 的 client_max_body_size 一致
# MAX_FILE_SIZE_MB=50
# MAX_TEXT_LENGTH=5000

# ── 服務設定（選填）──

# 網關端口
# GATEWAY_PORT=8000

# 設定檔路徑（本機 services_config.yaml／Docker services_config_docker.yaml／VPS services_config_vps.yaml）
# GATEWAY_CONFIG=services_config.yaml

# 個別覆蓋某個服務的 endpoint，不用改 yaml：<SERVICE_TYPE>_ENDPOINT
# TAIWANESE_ASR_ENDPOINT=http://127.0.0.1:8001
# CHINESE_ASR_ENDPOINT=http://127.0.0.1:8002
# TAIWANESE_TTS_ENDPOINT=http://127.0.0.1:8003
# CHINESE_TTS_ENDPOINT=http://127.0.0.1:8004

# ── 中文 TTS（BreezyVoice）──
# USE_FP16=1
# USE_CUDNN_BENCHMARK=0
# MAX_CHUNK_LEN=30

# ── 台語 TTS（Chatterbox）──
# 台語 TTS 服務（:8003）讀這三個：
# CB_API=http://127.0.0.1:9881
# CB_TIMEOUT=280
# MAX_SEG_LEN=70                 # 台羅字元數；實測 80 內穩定，超過句尾聲調會失準
#
# 引擎（engine/cb_server.py，在 cb conda 環境另外啟動）讀下面這些。
# ⚠️ 引擎不會自動讀 .env，請在啟動指令前面帶上，或先 export。
# CB_ROOT=~/chatterbox-finetuning
# CB_ADAPTER=chatterbox_output_sandhi/new_lang_adapter   # 模型 B（相對於 CB_ROOT）
# CB_REF=speaker_reference/ref3.wav                      # 參考音（相對於 CB_ROOT）
# CB_SANDHI=1                    # 模型 B 必須為 1（訓練資料經過變調轉換）
# CB_CANDIDATES=1                # 設 3 可降低「開頭重複第一個字」，但合成時間約 3 倍
# CB_SEED=2
# CB_HOST=127.0.0.1              # 台語 TTS 改用 Docker 時要改 0.0.0.0，並務必 sudo ufw deny 9881/tcp
# CB_PORT=9881
